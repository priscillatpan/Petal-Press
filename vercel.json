{
  "buildCommand": "pnpm --filter @workspace/petal-press run build",
  "outputDirectory": "artifacts/petal-press/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "ignoreCommand": "exit 1",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
